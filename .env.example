# Copy to .env and fill in. Never commit .env.

# Wallet that deploys the contract. Needs a little USDC on Arc for gas.
DEPLOYER_PRIVATE_KEY=

# Optional; defaults to Arc mainnet (https://rpc.mainnet.arc.io)
ARC_RPC_URL=

# ---- relayer (uv run python -m dollardrop.relayer)
# Hot wallet that submits claims. Keep only a small USDC float in it.
RELAYER_PRIVATE_KEY=
# Defaults to the address in deployments/<network>.json
DOLLARDROP_ADDRESS=
# Stop relaying when the relayer's balance drops below this (USDC)
MIN_RELAYER_BALANCE_USDC=1
# Comma-separated origins of the claim/organizer pages
CORS_ORIGINS=http://localhost:5173
HOST=127.0.0.1
PORT=8000
