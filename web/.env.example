# Copy to web/.env. Everything here is PUBLIC (it ends up in the browser bundle).
# Never put private keys or the Circle API key here.

# Arc mainnet = 5042, Arc testnet = 5042002
VITE_CHAIN_ID=5042
VITE_RPC_URL=https://rpc.mainnet.arc.io
# From deployments/<network>.json
VITE_DOLLARDROP_ADDRESS=
# Block the contract was deployed in (speeds up finding a campaign's drops)
VITE_DEPLOY_BLOCK=0
VITE_RELAYER_URL=http://localhost:8000
# Optional block explorer for transaction links, e.g. https://arcscan.app
VITE_EXPLORER_URL=

# Optional: Google / email sign-in via Circle user-controlled wallets
VITE_CIRCLE_APP_ID=
VITE_GOOGLE_CLIENT_ID=
